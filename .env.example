APP_NAME=Stockify POS API
PORT=3001
NODE_ENV=production
# Generate strong 64-character secrets for production (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_64_character_hex_jwt_key_here
CSRF_SECRET=your_super_secret_64_character_hex_csrf_key_here
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
# Additional allowed origins for CORS (comma-separated, optional)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://pos.yourdomain.com
# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Google Gemini API key for AI Copilot (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
